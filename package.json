{
  "name": "playwrightautomation",
  "version": "1.0.0",
  "description": "Playwright JS automation framework for Adactin Hotel App with POM, JSON data-driven tests, Allure reporting and API automation",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:api": "playwright test tests/api.spec.js",
    "test:ui": "playwright test --ui",
    "report:html": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "mock:api": "node mock/server.js"
  },
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.0"
  }
}
